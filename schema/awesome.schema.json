{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/floatdrop/awesome-go/main/schema/awesome.schema.json",
  "title": "Awesome Go list",
  "type": "object",
  "additionalProperties": false,
  "required": ["list", "policy", "categories", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "repo", "branch", "description"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$" },
        "branch": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "podium": { "type": "integer", "minimum": 0, "description": "Entries per category shown with medals; 0 disables the podium." }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_age_days": { "type": "integer", "minimum": 0 },
        "min_stars": { "type": "integer", "minimum": 0 },
        "max_inactive_days": { "type": "integer", "minimum": 0 },
        "max_description_length": { "type": "integer", "minimum": 20 },
        "require_license": { "type": "boolean" },
        "require_go": { "type": "boolean" },
        "allow_forks": { "type": "boolean" }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repo", "description", "category"],
        "properties": {
          "repo": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$", "description": "GitHub owner/name, no URL." },
          "name": { "type": "string", "minLength": 1, "description": "Display name; defaults to the repository name." },
          "description": { "type": "string", "minLength": 10, "maxLength": 100, "pattern": "^[A-Z0-9].*\\.$" },
          "category": { "type": "string" },
          "added": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Set automatically on acceptance; leave empty." },
          "exempt": {
            "type": "array",
            "uniqueItems": true,
            "items": { "enum": ["fork", "inactive"] },
            "description": "Policy rules a maintainer waived for this entry; must be justified in the PR."
          }
        }
      }
    }
  }
}
