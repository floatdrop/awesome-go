{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/floatdrop/awesome-go/main/schema/list.schema.json",
  "title": "Awesome Go list configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "list",
    "policy",
    "categories"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "list": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "repo",
        "branch",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9_.-]+$"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "site": {
          "type": "string",
          "format": "uri",
          "description": "Published site URL; defaults to https://<owner>.github.io/<name>/."
        },
        "podium": {
          "type": "integer",
          "minimum": 0,
          "description": "Entries per category shown before the rest is collapsed under More; the first three get medals. 0 shows a flat list."
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_age_days": {
          "type": "integer",
          "minimum": 0
        },
        "min_stars": {
          "type": "integer",
          "minimum": 0
        },
        "max_inactive_days": {
          "type": "integer",
          "minimum": 0
        },
        "max_description_length": {
          "type": "integer",
          "minimum": 20
        },
        "require_license": {
          "type": "boolean"
        },
        "require_go": {
          "type": "boolean"
        },
        "allow_forks": {
          "type": "boolean"
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
